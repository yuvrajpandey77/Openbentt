# Client LaTeX WASM (~175MB). CI/Docker: run npm run download:busytex before build.
public/core/busytex/

# Bundled llama-server binaries (~50–120MB each). CI/dev: npm run download:llama-server
.cache/
resources/llama/linux/llama-server
resources/llama/darwin/llama-server
resources/llama/win32/llama-server.exe
resources/llama/win32/*.dll

# Bombadil property-based browser runs
bombadil-output/

# Keep paper-orchestra-main in the repo (runtime engine). Ignore only local venvs/outputs.
paper-orchestra-main/.venv/
paper-orchestra-main/**/__pycache__/
paper-orchestra-main/paper_output_*/
paper-orchestra-main/.env
paper-orchestrator-main/
